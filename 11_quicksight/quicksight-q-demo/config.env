# QuickSight Q Demo Configuration
#
# Source this file from every script:  source "$(dirname "$0")/config.env"
# All values can be overridden via environment variables before sourcing.
#
# REQUIRED env vars (no defaults — fail fast if unset):
#   QS_USER_ARN        - QuickSight user ARN that should own/admin the demo
#                        e.g. arn:aws:quicksight:us-east-1:123456789012:user/default/alice
#   NOTIFICATION_EMAIL - Email for QuickSight account-level notifications
#
# OPTIONAL env vars (defaults below):
#   AWS_REGION                - AWS region (default: us-east-1)
#   REDSHIFT_CLUSTER_ID       - Redshift cluster identifier
#   REDSHIFT_DATABASE         - Redshift database name
#   REDSHIFT_ADMIN_USER       - Admin DB user used by Redshift Data API for DDL
#   QS_DB_USER                - DB user QuickSight authenticates as
#   QS_DB_SECRET_NAME         - Secrets Manager secret holding QS_DB_USER's password
#   DATA_SOURCE_ID / DATASET_ID / TOPIC_ID / DASHBOARD_ID
#   IAM_POLICY_NAME           - IAM policy name created for QuickSight->Redshift
#   QUICKSIGHT_SERVICE_ROLE   - Service-linked role name for QuickSight

# ---------- AWS ----------
export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-$(aws sts get-caller-identity --query Account --output text)}"

# ---------- Redshift ----------
export REDSHIFT_CLUSTER_ID="${REDSHIFT_CLUSTER_ID:-sales-demo-cluster}"
export REDSHIFT_DATABASE="${REDSHIFT_DATABASE:-salesdb}"
export REDSHIFT_ADMIN_USER="${REDSHIFT_ADMIN_USER:-admin}"
# Cluster endpoint is discovered dynamically (see lib/common.sh::get_redshift_endpoint).
# Do NOT hardcode a per-account subdomain here.

# ---------- QuickSight DB User ----------
export QS_DB_USER="${QS_DB_USER:-quicksight_user}"
export QS_DB_SECRET_NAME="${QS_DB_SECRET_NAME:-quicksight-q-demo/${QS_DB_USER}}"

# ---------- QuickSight Resource IDs ----------
export QUICKSIGHT_NAMESPACE="${QUICKSIGHT_NAMESPACE:-default}"
export DATA_SOURCE_ID="${DATA_SOURCE_ID:-redshift-sales-demo-datasource}"
export DATA_SOURCE_NAME="${DATA_SOURCE_NAME:-Redshift Sales Demo}"
export DATASET_ID="${DATASET_ID:-sales-demo-dataset}"
export DATASET_NAME="${DATASET_NAME:-Sales Demo Dataset}"
export TOPIC_ID="${TOPIC_ID:-sales-topic}"
export TOPIC_NAME="${TOPIC_NAME:-Sales Topic}"
export DASHBOARD_ID="${DASHBOARD_ID:-sales-q-demo-dashboard}"

# ---------- IAM ----------
export IAM_POLICY_NAME="${IAM_POLICY_NAME:-QuickSightRedshiftAccess}"
export QUICKSIGHT_SERVICE_ROLE="${QUICKSIGHT_SERVICE_ROLE:-aws-quicksight-service-role-v0}"

# ---------- VPC Connection (optional) ----------
# Set QS_VPC_CONNECTION_ID when the Redshift cluster is private
# (PubliclyAccessible=false). The data source will route through this
# QuickSight VPC connection instead of the public internet. Leave unset for
# publicly-accessible clusters.
#
# The SG and IAM role names are used by cleanup.sh to tear down the supporting
# resources we created alongside the VPC connection. Cleanup is a no-op if
# they don't exist, so the defaults are safe even when the VPC connection
# wasn't used.
export QS_VPC_CONNECTION_ID="${QS_VPC_CONNECTION_ID:-}"
export QS_VPC_CONNECTION_SG_NAME="${QS_VPC_CONNECTION_SG_NAME:-quicksight-q-demo-eni}"
export QS_VPC_CONNECTION_ROLE_NAME="${QS_VPC_CONNECTION_ROLE_NAME:-QuickSightVPCConnectionRole}"
export QS_VPC_CONNECTION_ROLE_INLINE_POLICY="${QS_VPC_CONNECTION_ROLE_INLINE_POLICY:-QuickSightVPCConnectionInline}"

# ---------- Identity (REQUIRED — must be exported before sourcing) ----------
# Intentionally not defaulted. lib/common.sh::require_identity_vars enforces.
export QS_USER_ARN="${QS_USER_ARN:-}"
export NOTIFICATION_EMAIL="${NOTIFICATION_EMAIL:-}"

# ---------- Demo metadata ----------
export DEMO_NAME="${DEMO_NAME:-Sales Q Demo}"
export DEMO_DESCRIPTION="${DEMO_DESCRIPTION:-Comprehensive QuickSight Q demonstration with natural language querying}"
